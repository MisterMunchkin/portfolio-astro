---
import "../css/portfolio.css";
interface Props {
  title: string;
  description?: string;
  preloadDisplay?: boolean;
}
const {
  title,
  description = "Robin Dalmy is a software engineer working across mobile, full-stack development, and agentic engineering tools. Explore selected work and get in touch.",
  preloadDisplay = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#11130f" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href="/fonts/Geist-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {
      preloadDisplay && (
        <link
          rel="preload"
          href="/fonts/Geist-Black.woff2"
          as="font"
          type="font/woff2"
          crossorigin
        />
      )
    }
    <title>{title}</title>
  </head>
  <body><a class="skip-link" href="#main">Skip to content</a><slot /></body>
</html>
