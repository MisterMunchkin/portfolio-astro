<aside
  class="tree-rail"
  aria-label="A connected practice, mango seasons artwork"
>
  <div class="tree-studio" data-chapter="about" data-season="evergreen">
    <div class="tree-heading mono">
      <span>Fig. 01 / Mangifera indica</span><span aria-hidden="true">↗</span>
    </div>
    <div class="tree-art">
      <div class="tree-orbit" aria-hidden="true"></div>
      <div
        class="tree-stage"
        role="img"
        aria-label="An evergreen mango tree with sculpted bronze branches and long, drooping green leaves."
      >
        <img
          class="tree-fallback"
          src="/art/branching-tree.svg"
          alt=""
          width="600"
          height="650"
        />
        <canvas class="tree-canvas" aria-hidden="true" hidden></canvas>
      </div>
      <span class="tree-ground" aria-hidden="true"></span>
      <span class="tree-coordinate mono" aria-hidden="true"
        >Rooted in curiosity.<br />Always branching out.</span
      >
    </div>
    <div class="tree-caption">
      <p class="tree-eyebrow mono">One tree. A changing season.</p>
      <p class="tree-chapter">Start with <em>curiosity.</em></p>
      <nav class="tree-chapters" aria-label="Page chapters">
        <a href="#about" aria-current="location"
          ><span class="mono">01</span><span>Approach</span></a
        >
        <a href="#work"><span class="mono">02</span><span>Work</span></a>
        <a href="#experience"
          ><span class="mono">03</span><span>Experience</span></a
        >
        <a href="#contact"><span class="mono">04</span><span>Connect</span></a>
      </nav>
    </div>
    <div class="tree-season">
      <span class="tree-season-index mono">04</span><p>
        <span class="tree-season-name">Evergreen</span><span
          class="tree-season-note mono">A season of possibility</span
        >
      </p><span class="tree-season-mark" aria-hidden="true">↘</span>
    </div>
    <p class="tree-hint mono" hidden>Scroll to follow the seasons</p>
  </div>
</aside>

<script>
  import {
    createTree,
    projectTree,
    mangoFrames,
    mangoScene,
  } from "../utils/tree-geometry";
  const root = document.querySelector<HTMLElement>(".tree-studio");
  if (root) {
    const stage = root.querySelector<HTMLElement>(".tree-stage")!;
    const canvas = root.querySelector<HTMLCanvasElement>("canvas")!;
    const ctx = canvas.getContext("2d");
    const reduced = matchMedia("(prefers-reduced-motion: reduce)");
    const journey = document.querySelector<HTMLElement>(".journey")!;
    const chapters = [
      ...document.querySelectorAll<HTMLElement>(
        ".journey-content > section[id]",
      ),
    ];
    const links = [
      ...root.querySelectorAll<HTMLAnchorElement>(".tree-chapters a"),
    ];
    const titles: Record<string, [string, string]> = {
      about: ["Start with ", "curiosity."],
      work: ["Branch into ", "possibility."],
      experience: ["Rooted in ", "experience."],
      contact: ["Good things ", "grow together."],
    };
    const seasons: Record<string, [string, string, string]> = {
      flush: ["01", "New growth", "Copper leaves, new beginnings"],
      bloom: ["02", "In blossom", "Small flowers, new possibilities"],
      fruit: ["03", "Bearing fruit", "Green mangoes ripen to gold"],
      evergreen: ["04", "Evergreen", "A pause before the next season"],
    };
    let chapter = "about",
      season = "",
      frame = 0,
      buildFrame = 0,
      active = true,
      visible = true,
      width = 0,
      height = 0,
      dpr = 1,
      version = 0;
    let cache: HTMLCanvasElement[] = [];
    let mesh: ReturnType<typeof createTree> | null = null;
    const setSeason = (name: string) => {
      if (season === name) return;
      season = name;
      root.dataset.season = name;
      const [index, title, note] = seasons[name];
      root.querySelector(".tree-season-index")!.textContent = index;
      root.querySelector(".tree-season-name")!.textContent = title;
      root.querySelector(".tree-season-note")!.textContent = reduced.matches
        ? "A still view · reduced motion"
        : !ctx
          ? "A still view of the canopy"
          : note;
      root.querySelector(".tree-hint")!.textContent = reduced.matches
        ? "Still artwork · reduced motion"
        : !ctx
          ? "Static mango study"
          : "Scroll to follow the seasons";
    };
    const paint = () => {
      frame = 0;
      if (!active) return;
      const position = journey.getBoundingClientRect();
      const progress = Math.max(
        0,
        Math.min(1, -position.top / Math.max(1, position.height - innerHeight)),
      );
      root.dataset.progress = progress.toFixed(4);
      let current = chapters[0];
      for (const section of chapters)
        if (section.getBoundingClientRect().top < innerHeight * 0.45)
          current = section;
      if (current && chapter !== current.id) {
        chapter = current.id;
        root.dataset.chapter = chapter;
        const [text, emphasis] = titles[chapter],
          em = document.createElement("em");
        em.textContent = emphasis;
        root
          .querySelector(".tree-chapter")!
          .replaceChildren(document.createTextNode(text), em);
        links.forEach((link) =>
          link.hash === `#${chapter}`
            ? link.setAttribute("aria-current", "location")
            : link.removeAttribute("aria-current"),
        );
      }
      const scene = mangoScene(progress);
      setSeason(reduced.matches || !ctx ? "evergreen" : scene.stage);
      if (
        reduced.matches ||
        !ctx ||
        !visible ||
        cache.length !== mangoFrames.length
      )
        return;
      ctx.clearRect(0, 0, width, height);
      const blend = scene.to === scene.from ? 0 : scene.blend;
      ctx.globalCompositeOperation = "source-over";
      ctx.globalAlpha = 1 - blend;
      ctx.drawImage(cache[scene.from], 0, 0, width, height);
      if (blend > 0) {
        ctx.globalCompositeOperation = "lighter";
        ctx.globalAlpha = blend;
        ctx.drawImage(cache[scene.to], 0, 0, width, height);
      }
      ctx.globalCompositeOperation = "source-over";
      ctx.globalAlpha = 1;
      canvas.hidden = false;
      root.classList.add("tree-ready");
    };
    const schedule = () => {
      if (active && !frame) frame = requestAnimationFrame(paint);
    };
    const rebuild = () => {
      const token = ++version;
      cancelAnimationFrame(buildFrame);
      cache = [];
      canvas.hidden = true;
      root.classList.remove("tree-ready");
      if (!ctx || reduced.matches || !width || !height || !visible || !active)
        return;
      mesh ??= createTree(3);
      let index = 0;
      const next = () => {
        if (token !== version || !active || !visible || reduced.matches) return;
        const buffer = document.createElement("canvas");
        buffer.width = canvas.width;
        buffer.height = canvas.height;
        const brush = buffer.getContext("2d");
        if (!brush) return;
        brush.setTransform(dpr, 0, 0, dpr, 0, 0);
        for (const face of projectTree(
          mesh!,
          width,
          height,
          -0.38,
          0.07,
          mangoFrames[index],
        )) {
          if (face.opacity < 0.002) continue;
          brush.globalAlpha = face.opacity;
          brush.beginPath();
          face.points.forEach(([x, y], i) =>
            i ? brush.lineTo(x, y) : brush.moveTo(x, y),
          );
          brush.closePath();
          brush.fillStyle = face.fill;
          brush.strokeStyle = face.fill;
          brush.lineWidth = 0.35;
          brush.fill();
          brush.stroke();
        }
        cache.push(buffer);
        index++;
        if (index < mangoFrames.length)
          buildFrame = requestAnimationFrame(next);
        else schedule();
      };
      buildFrame = requestAnimationFrame(next);
    };
    const resize = new ResizeObserver(() => {
      const rect = stage.getBoundingClientRect(),
        nextDpr = Math.min(devicePixelRatio || 1, 1.5);
      if (rect.width === width && rect.height === height && nextDpr === dpr)
        return;
      width = rect.width;
      height = rect.height;
      dpr = nextDpr;
      if (ctx) {
        canvas.width = Math.round(width * dpr);
        canvas.height = Math.round(height * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      }
      rebuild();
      schedule();
    });
    const intersection = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible) {
        if (cache.length !== mangoFrames.length) rebuild();
        schedule();
      }
    });
    const onMotion = () => {
      season = "";
      rebuild();
      schedule();
    };
    const onRestore = () => {
      schedule();
    };
    const observe = () => {
      active = true;
      resize.observe(stage);
      intersection.observe(stage);
      window.addEventListener("scroll", schedule, { passive: true });
      window.addEventListener("hashchange", onRestore);
      window.addEventListener("resize", onRestore);
      reduced.addEventListener("change", onMotion);
      schedule();
    };
    const suspend = () => {
      active = false;
      version++;
      cancelAnimationFrame(frame);
      cancelAnimationFrame(buildFrame);
      frame = 0;
      resize.disconnect();
      intersection.disconnect();
      window.removeEventListener("scroll", schedule);
      window.removeEventListener("hashchange", onRestore);
      window.removeEventListener("resize", onRestore);
      reduced.removeEventListener("change", onMotion);
    };
    root.querySelector<HTMLElement>(".tree-hint")!.hidden = false;
    observe();
    window.addEventListener("pagehide", suspend);
    window.addEventListener("pageshow", (event) => {
      if (event.persisted) {
        observe();
        rebuild();
      }
    });
  }
</script>
